{
  "name": "mabataki-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Web-native 2D avatar runtime workspace",
  "license": "MIT",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "pnpm build:packages && pnpm --filter @mabataki/demo dev",
    "build:packages": "pnpm --filter './packages/**' build",
    "build": "pnpm -r --if-present build",
    "test": "pnpm build:packages && pnpm -r --if-present test",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
